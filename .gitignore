# Only application sources and required build files are published.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/build.gradle
!/settings.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/lint.xml
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/android.yml
!/.github/scripts/
!/.githooks/
/.githooks/*
!/.githooks/post-commit
!/gradle/
/gradle/*
!/gradle/wrapper/
/gradle/wrapper/*
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties
!/app/
/app/*
!/app/build.gradle
!/app/proguard-rules.pro
!/app/src/

# Generated output and local tooling are never source files.
**/build/
**/.gradle/
**/.idea/
**/.cursor/
**/.claude/
**/.codex/
**/.task/
**/docs/
**/CLAUDE.md
**/AGENTS.md
# Share repository-wide agent instructions across clones and sessions.
!/AGENTS.md
*.apk
*.aab
*.log
*.iml
.DS_Store
Thumbs.db
