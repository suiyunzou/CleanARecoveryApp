<?xml version="1.0" encoding="utf-8"?>
<!-- Mihomo 代理 UI（FlClash 风格改版）：顶部「代理/配置」双板块切换
     代理页 = 连接状态卡 + 分组标签 + 双列节点卡片网格 + 延迟测试 FAB
     配置页 = 配置(订阅)卡片列表 + 添加配置 FAB -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_md">

        <ImageButton
            android:id="@+id/proxy_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/browser_nav_back"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:text="@string/proxy_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_section"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/proxy_status_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/proxy_status_off"
            android:scaleType="centerInside"
            android:src="@drawable/ic_proxy_off" />
    </LinearLayout>

    <!-- 顶层板块切换：代理 | 配置 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/proxy_section_tabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/surface_card"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/brand_primary"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="@color/text_primary"
        app:tabTextColor="@color/text_muted"
        app:tabTextAppearance="@android:style/TextAppearance.DeviceDefault.Small"
        android:textAlignment="center" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===================== 代理页 ===================== -->
        <LinearLayout
            android:id="@+id/proxy_page_proxies"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 分组标签（全部 / 协议）；仅代理运行时可见 -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/proxy_group_tabs"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@android:color/transparent"
                app:tabGravity="start"
                app:tabIndicatorColor="@color/brand_primary"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="2dp"
                app:tabMinWidth="0dp"
                app:tabMode="scrollable"
                app:tabPaddingStart="@dimen/space_md"
                app:tabPaddingEnd="@dimen/space_md"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="@color/text_primary"
                app:tabTextColor="@color/text_muted"
                app:tabTextAppearance="@android:style/TextAppearance.DeviceDefault.Small" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/proxy_node_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="96dp"
                    android:paddingHorizontal="6dp"
                    android:paddingTop="2dp" />

                <!-- 空状态（两种文案：未运行 / 运行但无节点） -->
                <LinearLayout
                    android:id="@+id/proxy_node_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/proxy_node_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/proxy_node_empty_title"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_section"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/proxy_node_empty_hint"
                        android:layout_width="230dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center"
                        android:text="@string/proxy_node_empty_hint"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ===================== 配置页 ===================== -->
        <LinearLayout
            android:id="@+id/proxy_page_profiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 连接状态卡：代理启停做成滑动开关（FlClash/系统设置风格） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_lg"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/proxy_status_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/proxy_status_title_off"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/proxy_status_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/proxy_status_detail_off"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <android.widget.Switch
                    android:id="@+id/proxy_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:contentDescription="@string/proxy_switch_desc"
                    android:showText="false"
                    android:thumbTint="@color/proxy_switch_thumb"
                    android:trackTint="@color/proxy_switch_track" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/proxy_profile_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="96dp" />

                <!-- 空状态 -->
                <LinearLayout
                    android:id="@+id/proxy_profile_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/proxy_profile_empty_title"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_section"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="240dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:gravity="center"
                        android:text="@string/proxy_profile_empty_hint"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- 代理页 FAB：延迟测试 -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/proxy_latency_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/space_lg"
            android:contentDescription="@string/proxy_latency_test"
            android:text="@string/proxy_latency_test"
            android:textColor="@color/surface_card"
            app:backgroundTint="@color/brand_primary"
            app:icon="@drawable/ic_speed"
            app:iconTint="@color/surface_card" />

        <!-- 配置页 FAB：添加配置 -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/proxy_profile_add_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/space_lg"
            android:contentDescription="@string/proxy_profile_add"
            android:text="@string/proxy_profile_add"
            android:textColor="@color/surface_card"
            android:visibility="gone"
            app:backgroundTint="@color/brand_primary"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/surface_card" />
    </FrameLayout>
</LinearLayout>
