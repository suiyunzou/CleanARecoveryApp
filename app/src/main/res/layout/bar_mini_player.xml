<?xml version="1.0" encoding="utf-8"?>
<!-- 迷你播放条（概念版样式）：封面+探出的黑胶唱片 | 歌名+歌单入口胶囊 | 黑色圆形播放键 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_recent_scan_card"
    android:clickable="true"
    android:elevation="6dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <ImageButton
        android:id="@+id/mini_player_prev"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/preview_prev"
        android:src="@drawable/ic_chevron_left"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/mini_player_center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 封面 + 右侧探出的大黑胶唱片 + 唱臂（播放落盘/暂停抬臂） -->
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/mini_player_vinyl"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_vinyl_record" />

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_song_tile"
                android:clipToOutline="true"
                android:elevation="2dp">

                <ImageView
                    android:id="@+id/mini_player_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/music_album_cover"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mini_player_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="♪"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView
                android:id="@+id/mini_player_tonearm"
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:layout_gravity="end|top"
                android:contentDescription="@null"
                android:elevation="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tonearm" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 歌单/来源入口：点击打开队列弹窗（选择歌单） -->
            <LinearLayout
                android:id="@+id/mini_player_source_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_mini_source_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/mini_player_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="150dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/music_queue"
                    android:src="@drawable/ic_swap" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/mini_player_next"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/preview_next"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone" />

    <!-- 黑色圆形播放/暂停键 -->
    <ImageView
        android:id="@+id/mini_player_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_play_fab"
        android:contentDescription="@string/music_now_playing"
        android:padding="11dp"
        android:src="@drawable/ic_play_outline"
        app:tint="#FFFFFF" />
</LinearLayout>
