<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_category_tile"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:gravity="center"
    android:minHeight="96dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xs"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/space_xs"
    android:paddingBottom="@dimen/space_md">

    <ImageView
        android:id="@+id/category_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_thumbnail_clip"
        android:contentDescription="@string/app_name"
        android:padding="7dp"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/category_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingTop="@dimen/space_sm"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/category_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingTop="2dp"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_micro" />
</LinearLayout>
