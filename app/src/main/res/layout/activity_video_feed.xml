<?xml version="1.0" encoding="utf-8"?>
<!-- 抖音模式 feed：垂直滑动短视频/视频流 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/feed_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/feed_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="10dp"
        android:background="@drawable/bg_feed_overlay"
        android:contentDescription="@string/feed_back"
        android:src="@drawable/ic_close"
        android:padding="10dp"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/feed_top_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:alpha="0.7"
        android:text="@string/feed_mode_title"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</FrameLayout>
