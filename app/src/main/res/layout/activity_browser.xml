<?xml version="1.0" encoding="utf-8"?>
<!-- VIA 主布局：顶栏(网站信息|标题/地址|扫码) + 内容 + 底栏五键(后|前|主页|标签|菜单) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/browser_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/browser_toolbar_primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/browser_nav_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_via_toolbar_button"
                android:contentDescription="@string/browser_nav_back"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/browser_nav_forward"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_via_toolbar_button"
                android:contentDescription="@string/browser_nav_forward"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_forward"
                android:visibility="gone" />

            <EditText
                android:id="@+id/browser_url_input"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/browser_url_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri|textNoSuggestions"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="16sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/browser_home"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_via_toolbar_button"
                android:contentDescription="@string/nav_home"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_home"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/browser_tabs"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_via_toolbar_button"
                    android:contentDescription="@string/via_menu_tabs"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_tabs" />

                <TextView
                    android:id="@+id/browser_tab_badge"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_tab_badge"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/browser_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_via_toolbar_button"
                android:contentDescription="@string/via_menu_button"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_menu"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/browser_proxy_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_proxy_dot"
                android:contentDescription="@string/via_proxy_off_short"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/browser_toolbar_address_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/browser_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/via_accent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/browser_web_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/browser_empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp"
            android:text="@string/browser_empty_hint"
            android:textColor="@color/text_muted"
            android:visibility="gone" />

        <!-- VIA 主页：Logo + 胶囊搜索框（快捷链接可滚动到下方） -->
        <ScrollView
            android:id="@+id/browser_home_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F5F5F5"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="72dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:id="@+id/browser_home_logo"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:contentDescription="@string/via_home_title"
                    android:src="@drawable/ic_via_logo" />

                <EditText
                    android:id="@+id/browser_home_search"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginStart="28dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginEnd="28dp"
                    android:background="@drawable/bg_via_pill_search"
                    android:hint="@string/browser_url_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textUri|textNoSuggestions"
                    android:maxLines="1"
                    android:paddingHorizontal="20dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="#B0B0B0"
                    android:textSize="15sp" />

                <GridLayout
                    android:id="@+id/browser_home_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:columnCount="4"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:useDefaultMargins="true" />

                <ImageButton
                    android:id="@+id/browser_home_add"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/via_home_add"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_add"
                    android:visibility="gone"
                    app:tint="#9E9E9E" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/browser_sniffer_panel"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@color/surface_card"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/browser_sniffer_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/browser_sniffer_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/brand_accent"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/browser_sniffer_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/browser_close_panel"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/browser_sniffer_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/browser_sniffer_hint"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/browser_media_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <Button
            android:id="@+id/browser_download_all"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/browser_download_selected"
            android:textAllCaps="false"
            android:textColor="@color/surface_card" />
    </LinearLayout>

</LinearLayout>
