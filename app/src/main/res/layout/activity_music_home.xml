<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_md">

        <ImageButton
            android:id="@+id/music_back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/button_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/music_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:text="@string/music_home_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/music_home_login_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/music_login"
            android:src="@drawable/ic_user"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Search bar -->
    <LinearLayout
        android:id="@+id/music_search_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_sm"
        android:background="@drawable/bg_button_secondary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="16dp" android:layout_height="16dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="@color/text_hint" />

        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:text="@string/music_search_hint"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs">

        <TextView
            android:id="@+id/music_chip_rec"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_chip_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="15dp"
            android:text="@string/music_tab_recommend"
            android:textColor="@color/text_on_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/music_chip_remote"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_chip_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="15dp"
            android:text="@string/music_tab_remote"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/music_chip_playlist"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_chip_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="15dp"
            android:text="@string/music_tab_playlists"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/music_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/music_mini_player_height">

            <!-- Recommendations -->
            <TextView
                android:id="@+id/music_sec_rec"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_lg" android:layout_marginTop="@dimen/space_lg"
                android:letterSpacing="0.08"
                android:text="@string/music_recommend"
                android:textColor="@color/text_hint"
                android:textSize="11.5sp" android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/music_home_rec_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:nestedScrollingEnabled="false" />

            <!-- Playlists -->
            <TextView
                android:id="@+id/music_sec_playlist"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_lg" android:layout_marginTop="@dimen/space_lg"
                android:letterSpacing="0.08"
                android:text="@string/music_playlists"
                android:textColor="@color/text_hint"
                android:textSize="11.5sp" android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/music_playlist_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_lg" />

            <!-- Kugou cloud playlists -->
            <TextView
                android:id="@+id/music_sec_remote"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_lg" android:layout_marginTop="@dimen/space_lg"
                android:letterSpacing="0.08"
                android:text="@string/music_remote_playlists"
                android:textColor="@color/text_hint"
                android:textSize="11.5sp" android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/music_remote_playlist_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_lg" />

        </LinearLayout>
    </ScrollView>

    <!-- Mini player stub (replaced by include at runtime) - always visible -->
    <FrameLayout
        android:id="@+id/mini_player_stub"
        android:layout_width="match_parent"
        android:layout_height="@dimen/music_mini_player_height"
        android:visibility="visible" />

</LinearLayout>
