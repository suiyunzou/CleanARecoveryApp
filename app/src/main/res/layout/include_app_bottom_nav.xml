<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_nav"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/bg_bottom_nav"
    android:elevation="0dp"
    android:orientation="horizontal"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_home_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/nav_home"
            android:padding="5dp"
            android:src="@drawable/ic_nav_home" />

        <TextView
            android:id="@+id/nav_home_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_home"
            android:textColor="@color/brand_primary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_results"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_results_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/nav_results"
            android:padding="5dp"
            android:src="@drawable/ic_nav_scan" />

        <TextView
            android:id="@+id/nav_results_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_results"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_folder"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_folder_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/nav_folder"
            android:padding="5dp"
            android:src="@drawable/ic_nav_folder" />

        <TextView
            android:id="@+id/nav_folder_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_folder"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_about"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_about_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/nav_about"
            android:padding="5dp"
            android:src="@drawable/ic_settings_gear" />

        <TextView
            android:id="@+id/nav_about_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_about"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
