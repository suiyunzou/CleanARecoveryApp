<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_card"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="0dp">

        <ImageButton
            android:id="@+id/mgr_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_via_toolbar_button"
            android:contentDescription="@string/button_back"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/mgr_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="normal" />

        <ImageButton
            android:id="@+id/mgr_action"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_via_toolbar_button"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_add"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/mgr_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/border_subtle"
            android:dividerHeight="0.5dp"
            android:listSelector="@drawable/bg_via_menu_cell" />

        <TextView
            android:id="@+id/mgr_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/space_xl"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
