<?xml version="1.0" encoding="utf-8"?>
<!-- 圆形封面：白色外环 + 内部唱片区（概念版样式） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface_card" />
        </shape>
    </item>
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/surface_track" />
        </shape>
    </item>
</layer-list>
